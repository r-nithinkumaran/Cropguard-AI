              <path d="M200 40C110 90 70 170 70 230c0 70 55 120 130 120s130-50 130-120c0-60-40-140-130-190z" fill="#3e8e41"/>
              <path d="M200 70v270M200 160l-62-34M200 220l-70-38M200 280l-52-26M200 160l62-34M200 220l70-38M200 280l52-26" stroke="#dcebd3" stroke-width="5" stroke-linecap="round" fill="none"/>
