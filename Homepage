      <div class="wrap">
        <div class="cta-box">
          <h2>Ready to check your first crop?</h2>
          <div class="actions">
            <a class="btn btn-solid" href="scan.html">Scan a leaf</a>
            <a class="btn btn-line" href="contact.html">Talk to us</a>
          </div>
        </div>
      </div>
